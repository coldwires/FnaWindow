# Normalize line endings. Text files are stored as LF in the repo and checked
# out as LF on every platform, so working copies stay consistent.
* text=auto eol=lf

# Windows-specific files that tools expect with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binary assets - never touch these.
*.png binary
*.dll binary
*.ico binary
