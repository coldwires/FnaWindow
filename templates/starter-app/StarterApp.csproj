<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A build-on for the FnaWindow engine. The engine is expected at engine/ as a git submodule:
        git submodule add https://github.com/coldwires/FnaWindow engine
    The single ProjectReference below pulls in the engine library, FNA, the native libs, and
    the bundled fonts. Nothing else to wire up.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>  <!-- GUI subsystem: Exe would open a console window alongside -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    engine/ is compiled by FnaWindow.csproj, NOT by this project's default **/*.cs glob. Without
    this, the engine's own sources (this template included) get compiled into your app and it fails
    with duplicate Program/Main definitions.
  -->
  <ItemGroup>
    <Compile Remove="engine\**\*.cs" />
    <None Remove="engine\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="engine\FnaWindow.csproj" />
  </ItemGroup>

</Project>
