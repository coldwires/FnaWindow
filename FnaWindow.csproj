<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FnaWindow - a reusable Windows 3.1-styled, borderless custom-window engine on FNA.

    This is the *library*. Reference it from your app and subclass WindowGame to build a
    complete desktop program with 100% custom chrome. The runnable example lives in Demo/.

    Vendors FNA + its native libs under lib/ (self-contained: clone anywhere and build).
    The engine source lives under src/ (Gui / Window / Theme / Editor / IO / Concurrency / Audio). The Content fonts and the
    native fnalibs are shipped as Content, so they flow into any project that references
    this one - a consumer gets a working window with no extra asset wiring.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FnaWindow</RootNamespace>
    <AssemblyName>FnaWindow</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Keep the library build to src/ only. The default SDK glob is recursive from this
    directory, so explicitly drop vendored FNA, the Demo app, and the copy-paste templates
    (each is its own project or non-project text).
  -->
  <ItemGroup>
    <Compile Remove="lib\**\*.cs" />
    <Compile Remove="Demo\**\*.cs" />
    <Compile Remove="templates\**\*.cs" />
    <None Remove="lib\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="lib\FNA\FNA.Core.csproj" />
  </ItemGroup>

  <!--
    Native libs and baked bitmap-font atlases, marked as Content so they copy to *this*
    project's output AND transitively into any consumer's output directory.
  -->
  <!--
    Which set of native libs to ship. x64 unless a consumer asks for x86, because a 32-bit process
    cannot load 64-bit natives and the failure is a BadImageFormatException at window creation with
    nothing pointing at the cause.

    A consumer asks by passing the property through its ProjectReference, which is the only way a
    property reliably reaches a referenced project:

      <ProjectReference Include="engine\FnaWindow.csproj"
                        AdditionalProperties="FnaWindowNativeArch=x86" />

    and setting <PlatformTarget>x86</PlatformTarget> on itself. The Link keeps the DLLs flat in the
    output directory either way, so nothing downstream sees the folder split.

    x86 has no D3D12Core.dll: the D3D12 Agility SDK ships x64 only, so FNA3D falls back to D3D11 on
    a 32-bit build.
  -->
  <PropertyGroup>
    <FnaWindowNativeArch Condition="'$(FnaWindowNativeArch)' == ''">x64</FnaWindowNativeArch>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="lib\fnalibs\$(FnaWindowNativeArch)\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <!-- Fonts change about never, so PreserveNewest is right for them. -->
    <Content Include="Content/fonts/**/*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Content/fonts/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <!--
      Skin art and cursors get edited while an app is running - the loop is "edit the PNG, dotnet
      run, look at it". PreserveNewest breaks that loop whenever the edited file ends up OLDER than
      the copy already in an app output folder (reverting a PNG, checking out an older branch,
      restoring a backup): the copy is silently skipped and you debug art that is not the art on
      disk. Always copies regardless of timestamp, and it carries transitively into every consuming
      app, which is where these files are actually read from.
      NOTE: %(RecursiveDir) is relative to the glob root, so each of these needs its own Link
      prefix - one shared Include would flatten skins/win31 to win31 and the app would find no art.
    -->
    <Content Include="Content/skins/**/*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>Content/skins/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="Content/cursors/**/*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>Content/cursors/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
