<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Demo - the runnable example app. It consumes FnaWindow exactly the way a build-on
    would: one ProjectReference to the engine, then subclass WindowGame. The engine's
    Content (fonts) and native libs flow in automatically, so there's nothing else to wire.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>  <!-- GUI subsystem: Exe would open a console window alongside -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FnaWindow.Demo</RootNamespace>
    <AssemblyName>FnaWindowDemo</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FnaWindow.csproj" />
  </ItemGroup>

</Project>
